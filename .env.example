# Copia este archivo a .env para desarrollo local.
# En Vercel: configura estas mismas variables en Settings > Environment Variables.

# --- Supabase (proyecto propio) ---
# Solo la publishable key viaja al navegador (prefijo VITE_).
SUPABASE_URL="https://TU-PROYECTO.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Opcional: solo si usas operaciones admin desde el servidor.
# NUNCA con prefijo VITE_ (es un secreto).
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# --- Sesión (login de la app) ---
# SESSION_SECRET debe tener al menos 32 caracteres.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="genera-una-cadena-larga-y-aleatoria-de-32-caracteres"
APP_USUARIO="admin"
APP_PASSWORD="cambia-esta-contrasena"
